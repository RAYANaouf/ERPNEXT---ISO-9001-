 "fields": [
  {
   "fieldname": "employee_section",
   "fieldtype": "Section Break",
   "label": "Employee"
  },
  {
   "fieldname": "employee",
   "fieldtype": "Link",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Employee",
   "options": "Employee",
   "reqd": 1
  },
  {
   "fetch_from": "employee.employee_name",
   "fieldname": "employee_name",
   "fieldtype": "Data",
   "label": "Employee Name",
   "read_only": 1
  },
  {
   "default": "Today",
   "fieldname": "incident_date",
   "fieldtype": "Date",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Incident Date",
   "reqd": 1
  },
  {
   "fetch_from": "employee.designation",
   "fieldname": "designation",
   "fieldtype": "Link",
   "label": "Designation",
   "options": "Designation",
   "read_only": 1
  },
  {
   "fetch_from": "employee.custom_fiche_de_poste",
   "fieldname": "job_description",
   "fieldtype": "Link",
   "label": "Fiche de poste",
   "options": "Job description",
   "read_only": 1
  },
  {
   "fetch_from": "employee.department",
   "fieldname": "department",
   "fieldtype": "Link",
   "in_standard_filter": 1,
   "label": "Department",
   "options": "Department",
   "read_only": 1
  },
  {
   "fetch_from": "employee.company",
   "fieldname": "company",
   "fieldtype": "Link",
   "label": "Company",
   "options": "Company",
   "read_only": 1
  },
  {
   "fetch_from": "employee.reports_to",
   "fieldname": "manager",
   "fieldtype": "Link",
   "label": "Manager",
   "options": "Employee",
   "read_only": 1
  },
  {
   "fieldname": "incident_section",
   "fieldtype": "Section Break",
   "label": "Incident Type"
  },
  {
   "fieldname": "incident_type",
   "fieldtype": "Select",
   "in_list_view": 1,
   "in_standard_filter": 1,
   "label": "Incident Type",
   "options": "\nLate Arrival\nUnjustified Absence\nJustified Absence\nEarly Departure\nOther"
  },
  {
   "depends_on": "eval:doc.incident_type=='Other'",
   "fieldname": "other_incident",
   "fieldtype": "Data",
   "label": "Other Incident"
  },
  {
   "depends_on": "eval:['Late Arrival', 'Early Departure', 'Justified Absence', 'Unjustified Absence'].includes(doc.incident_type)",
   "fieldname": "timing_section",
   "fieldtype": "Section Break",
   "label": "Incident Details"
  },
  {
   "depends_on": "eval:['Late Arrival', 'Early Departure', 'Justified Absence', 'Unjustified Absence'].includes(doc.incident_type)",
   "fieldname": "shift_type",
   "fieldtype": "Link",
   "label": "Shift",
   "options": "Shift Type"
  },
  {
   "depends_on": "eval:doc.incident_type=='Late Arrival'",
   "fieldname": "scheduled_start",
   "fieldtype": "Datetime",
   "label": "Scheduled Arrival"
  },
  {
   "depends_on": "eval:doc.incident_type=='Late Arrival'",
   "fieldname": "actual_arrival",
   "fieldtype": "Datetime",
   "label": "Actual Arrival"
  },
  {
   "depends_on": "eval:doc.incident_type=='Late Arrival' && doc.late_minutes>0",
   "fieldname": "late_period",
   "fieldtype": "Data",
   "label": "Late Period",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.incident_type=='Late Arrival' && doc.scheduled_start && doc.actual_arrival",
   "fieldname": "late_minutes",
   "fieldtype": "Float",
   "label": "Late Duration (min)",
   "precision": "2",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.incident_type=='Early Departure'",
   "fieldname": "scheduled_end",
   "fieldtype": "Datetime",
   "label": "Scheduled Departure"
  },
  {
   "depends_on": "eval:doc.incident_type=='Early Departure'",
   "fieldname": "actual_departure",
   "fieldtype": "Datetime",
   "label": "Actual Departure"
  },
  {
   "depends_on": "eval:doc.incident_type=='Early Departure' && doc.scheduled_end && doc.actual_departure",
   "fieldname": "early_minutes",
   "fieldtype": "Float",
   "label": "Early Departure Duration (min)",
   "precision": "2",
   "read_only": 1
  },
  {
   "depends_on": "eval:doc.incident_type=='Justified Absence' || doc.incident_type=='Unjustified Absence'",
   "fieldname": "absence_minutes",
   "fieldtype": "Float",
   "label": "Absence Duration (min)",
   "precision": "2"
  },
